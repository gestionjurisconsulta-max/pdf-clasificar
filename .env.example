# Copia este fichero a .env y rellénalo. .env está en .gitignore: nunca lo subas.

# --- Base de datos (docker-compose) ---------------------------------------
POSTGRES_USER=pdfclasificar
# OBLIGATORIA. Genera una larga y única, por ejemplo con: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=pdfclasificar

# --- Servicio web ----------------------------------------------------------
# Interfaz y puerto en los que se publica la aplicación. Por defecto sólo se
# escucha en la interfaz local, que es lo que quieres en un VPS: delante va el
# nginx del host haciendo de proxy con TLS (ver docs/despliegue.md). Pon
# HTTP_BIND=0.0.0.0 sólo si quieres llegar directamente desde la red.
HTTP_BIND=127.0.0.1
# Si el VPS tiene otros proyectos, comprueba que el puerto esté libre:
#   ss -ltnp | grep :8080
HTTP_PORT=8080

# Idioma de Tesseract para las páginas escaneadas. El modelo 'spa' viene
# instalado en la imagen del backend.
OCR_LANGUAGE=spa

# Tamaño máximo por fichero subido, en bytes (200 MB por defecto). Si lo subes,
# sube también client_max_body_size en docker/nginx.conf Y en el vhost del
# host (deploy/nginx/gestion.pdf.iages.es.conf): manda el más restrictivo.
MAX_UPLOAD_BYTES=209715200

# Los datos se borran al descargar el ZIP. Esta ventana es sólo para los
# trabajos que alguien deja a medias y nunca descarga.
PURGE_AFTER_HOURS=24


# --- Techos de recursos ----------------------------------------------------
# Para que un lote grande de OCR no deje sin CPU ni memoria a los demás
# proyectos del VPS. Los valores por defecto van sobrados para esta aplicación;
# ajústalos al tamaño real de la máquina.
# BACKEND_CPUS=2
# BACKEND_MEMORY=2g
# DB_MEMORY=512m
# FRONTEND_MEMORY=256m


# --- Sólo para desarrollo sin contenedores (npm run dev) -------------------
# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Sólo la usa el servidor de desarrollo de Vite; el navegador nunca la recibe.
GEMINI_API_KEY=

# Interfaz en la que escucha "npm run dev". Por defecto sólo localhost, porque
# el endpoint /api/analyze-invoice gasta la cuota de la API key sin pedir
# autenticación. Pon 0.0.0.0 sólo si necesitas abrirlo a tu red local.
# DEV_HOST=0.0.0.0
