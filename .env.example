# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Solo se usa en el servidor de desarrollo; el navegador nunca la recibe.
GEMINI_API_KEY=

# Interfaz en la que escucha "npm run dev". Por defecto solo localhost, porque
# el endpoint /api/analyze-invoice gasta la cuota de la API key sin pedir
# autenticacion. Pon 0.0.0.0 solo si necesitas abrirlo a tu red local.
# DEV_HOST=0.0.0.0
