# Estos ficheros se ejecutan DENTRO de contenedores Linux. Si Git los entrega
# con CRLF al clonar en Windows, el contenedor falla con un error opaco:
# "#!/bin/sh\r: no such file or directory".
*.sh            text eol=lf
entrypoint.sh   text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.ini           text eol=lf
.env.example    text eol=lf
.dockerignore   text eol=lf

# Binarios: que Git no intente normalizar nada.
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.woff2 binary
*.wasm  binary
*.bcmap binary
*.ttf   binary
*.pfb   binary
*.icc   binary
